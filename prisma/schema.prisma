generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; "rhel-openssl-3.0.x" = Vercel's serverless Linux environment.
  // If deploying elsewhere add the matching target (e.g. "debian-openssl-3.0.x" for Render/Railway).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Auth (NextAuth v5 / @auth/prisma-adapter) ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  username     String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  teamMembers  String[] @default([])
  createdAt    DateTime @default(now())

  submissions Submission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id           String        @id @default(cuid())
  name         String        @unique
  color        String        @default("#a855f7")
  createdAt    DateTime      @default(now())
  participants Participant[]
  submissions  Submission[]
}

model Participant {
  id     String @id @default(cuid())
  rsn    String @unique
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ── Bingo ──────────────────────────────────────────────────────────────────

model BingoBoard {
  id          String            @id @default(cuid())
  name        String
  description String?
  active      Boolean           @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  maxTeamSize Int               @default(10)
  passcode    String?           // optional event passcode — players must enter this once after login
  dinkToken     String?           // token players put in Dink's webhook URL (?token=xxx)
  rowColBonuses Json              @default("{}")  // { t1: number, t2: number, t3: number }
  createdAt     DateTime          @default(now())
  tiles         BingoTile[]
  snapshots     PlayerSnapshot[]
}

model PlayerSnapshot {
  id         String     @id @default(cuid())
  boardId    String
  board      BingoBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  memberName String
  bosses     Json
  takenAt    DateTime   @default(now())

  @@unique([boardId, memberName])
}

model BingoTile {
  id          String   @id @default(cuid())
  boardId     String
  position    Int      // 0–24 for a 5×5 grid
  title       String
  description String?
  imageUrl    String?  // reference/example image
  tiers       Json     @default("[]")  // TierDef[] — [{tier:1|2|3, points, requiredCount, dinkItems:[{id,name}]}]

  board       BingoBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([boardId, position])
}

model Submission {
  id         String           @id @default(cuid())
  userId     String?          // null for Dink/team submissions (no player login)
  teamId     String?          // which team this submission belongs to
  tileId     String
  imageUrl   String?          // Vercel Blob URL (null for Dink submissions with no screenshot)
  status     SubmissionStatus @default(PENDING)
  note       String?          // player note
  reviewNote String?          // admin feedback
  teamMember String?          // RSN for Dink
  source     String           @default("manual")  // "manual" | "dink"
  dinkItemId   Int?           // OSRS item ID that triggered this (duplicate detection)
  dinkItemName String?        // item name for display in admin queue
  tier         Int?           // which tier this submission satisfied (1=hardest, 3=easiest)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  user User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  team Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tile BingoTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
