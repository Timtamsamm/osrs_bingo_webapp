generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; "rhel-openssl-3.0.x" = Vercel's serverless Linux environment.
  // If deploying elsewhere add the matching target (e.g. "debian-openssl-3.0.x" for Render/Railway).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Auth (NextAuth v5 / @auth/prisma-adapter) ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  username     String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  teamMembers  String[] @default([])
  createdAt    DateTime @default(now())

  submissions Submission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Teams ──────────────────────────────────────────────────────────────────

model Team {
  id           String        @id @default(cuid())
  name         String        @unique
  color        String        @default("#a855f7")
  createdAt    DateTime      @default(now())
  participants Participant[]
  submissions  Submission[]
}

model Participant {
  id     String @id @default(cuid())
  rsn    String @unique
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ── Bingo ──────────────────────────────────────────────────────────────────

model BingoBoard {
  id          String            @id @default(cuid())
  name        String
  description String?
  active      Boolean           @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  passcode    String?           // optional event passcode — players must enter this once after login
  dinkToken     String?           // token players put in Dink's webhook URL (?token=xxx)
  rowColBonuses Json              @default("{}")  // { t1: number, t2: number, t3: number }
  size          Int               @default(5)     // grid is size x size (3, 4, or 5)
  scaleByTeamSize Boolean         @default(false) // when true, smaller teams need proportionally fewer drops/points to complete a tile (relative to the board's biggest team) — reward for completing stays the same
  templeSnapshotTakenAt DateTime? // set once, atomically, the first time TempleOSRS baselines are captured
  createdAt     DateTime          @default(now())
  tiles         BingoTile[]
  templeSnapshots TempleSnapshot[]
}

model TempleSnapshot {
  id                 String     @id @default(cuid())
  boardId            String
  board              BingoBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  rsn                String     // participant RSN at the time the baseline was captured
  stats              Json       // serialized TempleStats (ehp, ehb, skills, bosses, clues) at baseline
  collectionFinished Int        @default(0)
  takenAt            DateTime   @default(now())

  @@unique([boardId, rsn])
}

model BingoTile {
  id           String   @id @default(cuid())
  boardId      String
  position     Int      // 0–24 for a 5×5 grid
  title        String
  description  String?  // shown as "Tile Objective" in the public tile-detail popup
  rules        String?  @db.Text // shown on the public Rules page's Board Rules section — separate from description on purpose
  imageUrl     String?  // reference/example image
  scoringMode  String   @default("TIERED")  // "TIERED" | "POINTS"
  tiers        Json     @default("[]")  // TierDef[] — used when scoringMode = TIERED — [{tier:1|2|3, points, requiredCount, dinkItems:[{id,name}]}]
  pointsConfig Json?    // used when scoringMode = POINTS — { target: number, items: [{id, name, basePoints}] }

  board       BingoBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([boardId, position])
}

model Submission {
  id         String           @id @default(cuid())
  userId     String?          // null for Dink/team submissions (no player login)
  teamId     String?          // which team this submission belongs to
  tileId     String
  imageUrl   String?          // Vercel Blob URL (null for Dink submissions with no screenshot)
  status     SubmissionStatus @default(PENDING)
  note       String?          // player note
  reviewNote String?          // admin feedback
  teamMember String?          // RSN for Dink
  source     String           @default("manual")  // "manual" | "dink"
  dinkItemId   Int?           // OSRS item ID that triggered this (duplicate detection)
  dinkItemName String?        // item name for display in admin queue
  dinkSource   String?        // boss/NPC name Dink reported the drop came from — lets an item shared across multiple bosses' tiles (e.g. Dragon 2h sword) be traced/filtered by actual source
  tier         Int?           // which tier this submission satisfied (1=hardest, 3=easiest) — TIERED tiles only
  pointsAwarded Float?        // points this specific drop contributed — POINTS-mode tiles only
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  user User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  team Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tile BingoTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
}

// ── Boss item database (reference data for the admin tile editor's item picker) ─

model Boss {
  id    String     @id @default(cuid())
  name  String     @unique
  items BossItem[]
}

model BossItem {
  id      String @id @default(cuid())
  bossId  String
  boss    Boss   @relation(fields: [bossId], references: [id], onDelete: Cascade)
  itemId  Int    // OSRS item ID
  name    String
  sortOrder Int  @default(0)

  @@unique([bossId, itemId])
}

// ── Events ─────────────────────────────────────────────────────────────────

model Settings {
  id                 String  @id
  discordWebhookUrl  String? // posts an announcement embed here when an event is created
  generalRules       String? @db.Text // shown on the Rules page, above the per-tile board rules
  eventsWebhookToken String? // token for /api/webhook/events — deliberately separate from BingoBoard.dinkToken so the events link reveals nothing about a bingo board
}

// ── Clan events (separate from bingo) ──────────────────────────────────────
// Attendance comes from Dink webhooks: "!join"-style clan chat check-ins (seen
// by any clan member's Dink, so only an admin needs it set up), plus kill
// counts/loot from players who've opted in by adding the events webhook.

model ClanEvent {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime
  joinPhrase  String   @default("!join") // clan chat message that checks a player in (case-insensitive exact match)
  bossFilter  String?  // when set, only kills/loot whose source matches this (case-insensitive) count — null = anything counts
  createdAt   DateTime @default(now())

  attendees ClanEventAttendee[]
  activity  ClanEventActivity[]
}

model ClanEventAttendee {
  id          String    @id @default(cuid())
  eventId     String
  event       ClanEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsn         String    // display name as first seen
  rsnKey      String    // normalized RSN (see normalizeRsn) — dedupe key
  via         String    // how they were first recorded: "join" | "kill" | "loot" | "party" | "manual"
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([eventId, rsnKey])
}

model ClanEventActivity {
  id        String    @id @default(cuid())
  eventId   String
  event     ClanEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsn       String
  rsnKey    String
  type      String    // "KILL" | "LOOT"
  source    String?   // boss/NPC name
  killCount Int?      // KILL only — the player's KC after this kill
  itemId    Int?      // LOOT only
  itemName  String?
  quantity  Int?
  priceEach Int?      // GE price per item at drop time, as reported by Dink
  imageUrl  String?   // LOOT only — Dink's screenshot (Vercel Blob), shared by every item row from the same notification
  origin    String    @default("dink") // LOOT only — "dink" (Dink's Loot notifier) | "chat" (a forwarded "X received a drop: Y (Boss)" chat message); used to merge two reports of one drop
  createdAt DateTime  @default(now())

  @@index([eventId, createdAt])
}

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String?
  imageUrl         String?
  startsAt         DateTime
  endsAt           DateTime
  participantNames String[] @default([]) // clan member display names who took part (manually set for now)
  createdAt        DateTime @default(now())
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
