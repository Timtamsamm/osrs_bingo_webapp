# PostgreSQL connection string (pooled — used at runtime by Prisma)
# Neon: use the "pooled connection" string from your Neon dashboard
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# PostgreSQL direct connection string (used by Prisma migrations)
# Neon: use the "direct connection" string (no pgbouncer)
# If your provider gives only one URL, use the same value for both variables
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Random secret for signing session tokens — generate with: npx auth secret
AUTH_SECRET="your-random-secret-here"

# Vercel Blob storage token
# On Vercel this is injected automatically when you connect a Blob store
# For local dev: copy the token from your Blob store dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
